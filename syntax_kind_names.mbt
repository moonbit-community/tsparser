///|
/// Returns every declaration name attached to this numeric value. Most kinds
/// have one declaration whose name is also the runtime reverse name; only
/// marker-overwritten values and compatibility aliases need explicit entries.
pub fn SyntaxKind::declaration_names(
  self : SyntaxKind,
) -> ReadOnlyArray[String] {
  let names : Array[String] = match self.to_int() {
    0 => ["Unknown"]
    2 => ["SingleLineCommentTrivia"]
    7 => ["ConflictMarkerTrivia"]
    9 => ["NumericLiteral"]
    15 => ["NoSubstitutionTemplateLiteral"]
    18 => ["TemplateTail"]
    19 => ["OpenBraceToken"]
    30 => ["LessThanToken"]
    64 => ["EqualsToken"]
    65 => ["PlusEqualsToken"]
    79 => ["CaretEqualsToken"]
    83 => ["BreakKeyword"]
    118 => ["WithKeyword"]
    119 => ["ImplementsKeyword"]
    127 => ["YieldKeyword"]
    128 => ["AbstractKeyword"]
    166 => ["DeferKeyword"]
    167 => ["QualifiedName"]
    183 => ["TypePredicate"]
    206 => ["ImportType"]
    244 => ["VariableStatement"]
    260 => ["DebuggerStatement"]
    301 => ["ImportAttributes", "AssertClause"]
    302 => ["ImportAttribute", "AssertEntry"]
    310 => ["JSDocTypeExpression"]
    321 => ["JSDoc", "JSDocComment"]
    328 => ["JSDocTag"]
    352 => ["JSDocImportTag"]
    _ => [self.runtime_name()]
  }
  ReadOnlyArray::from_array(names)
}
