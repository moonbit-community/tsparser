///|
/// Returns the exact JavaScript runtime reverse-enum name. TypeScript aliases
/// overwrite earlier declarations, so this deliberately differs from the
/// primary declaration name at marker values and compatibility aliases.
pub fn SyntaxKind::runtime_name(self : SyntaxKind) -> String {
  match self.to_int() {
    0 => "FirstToken"
    1 => "EndOfFileToken"
    2 => "FirstTriviaToken"
    3 => "MultiLineCommentTrivia"
    4 => "NewLineTrivia"
    5 => "WhitespaceTrivia"
    6 => "ShebangTrivia"
    7 => "LastTriviaToken"
    8 => "NonTextFileMarkerTrivia"
    9 => "FirstLiteralToken"
    10 => "BigIntLiteral"
    11 => "StringLiteral"
    12 => "JsxText"
    13 => "JsxTextAllWhiteSpaces"
    14 => "RegularExpressionLiteral"
    15 => "FirstTemplateToken"
    16 => "TemplateHead"
    17 => "TemplateMiddle"
    18 => "LastTemplateToken"
    19 => "FirstPunctuation"
    20 => "CloseBraceToken"
    21 => "OpenParenToken"
    22 => "CloseParenToken"
    23 => "OpenBracketToken"
    24 => "CloseBracketToken"
    25 => "DotToken"
    26 => "DotDotDotToken"
    27 => "SemicolonToken"
    28 => "CommaToken"
    29 => "QuestionDotToken"
    30 => "FirstBinaryOperator"
    31 => "LessThanSlashToken"
    32 => "GreaterThanToken"
    33 => "LessThanEqualsToken"
    34 => "GreaterThanEqualsToken"
    35 => "EqualsEqualsToken"
    36 => "ExclamationEqualsToken"
    37 => "EqualsEqualsEqualsToken"
    38 => "ExclamationEqualsEqualsToken"
    39 => "EqualsGreaterThanToken"
    40 => "PlusToken"
    41 => "MinusToken"
    42 => "AsteriskToken"
    43 => "AsteriskAsteriskToken"
    44 => "SlashToken"
    45 => "PercentToken"
    46 => "PlusPlusToken"
    47 => "MinusMinusToken"
    48 => "LessThanLessThanToken"
    49 => "GreaterThanGreaterThanToken"
    50 => "GreaterThanGreaterThanGreaterThanToken"
    51 => "AmpersandToken"
    52 => "BarToken"
    53 => "CaretToken"
    54 => "ExclamationToken"
    55 => "TildeToken"
    56 => "AmpersandAmpersandToken"
    57 => "BarBarToken"
    58 => "QuestionToken"
    59 => "ColonToken"
    60 => "AtToken"
    61 => "QuestionQuestionToken"
    62 => "BacktickToken"
    63 => "HashToken"
    64 => "FirstAssignment"
    65 => "FirstCompoundAssignment"
    66 => "MinusEqualsToken"
    67 => "AsteriskEqualsToken"
    68 => "AsteriskAsteriskEqualsToken"
    69 => "SlashEqualsToken"
    70 => "PercentEqualsToken"
    71 => "LessThanLessThanEqualsToken"
    72 => "GreaterThanGreaterThanEqualsToken"
    73 => "GreaterThanGreaterThanGreaterThanEqualsToken"
    74 => "AmpersandEqualsToken"
