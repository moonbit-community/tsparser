///|
fn _assert_flag_values(values : Array[(UInt, UInt)]) -> Unit raise {
  for value in values {
    let (actual, expected) = value
    assert_eq(actual, expected)
  }
}

///|
test "all NodeFlags values match TypeScript 6.0.3" {
  _assert_flag_values([
    (NodeFlags::none().bits(), 0U),
    (NodeFlags::let_flag().bits(), 1U),
    (NodeFlags::const_flag().bits(), 2U),
    (NodeFlags::using_flag().bits(), 4U),
    (NodeFlags::await_using().bits(), 6U),
    (NodeFlags::nested_namespace().bits(), 8U),
    (NodeFlags::synthesized().bits(), 16U),
    (NodeFlags::namespace_flag().bits(), 32U),
    (NodeFlags::optional_chain().bits(), 64U),
    (NodeFlags::export_context().bits(), 128U),
    (NodeFlags::contains_this().bits(), 256U),
    (NodeFlags::has_implicit_return().bits(), 512U),
    (NodeFlags::has_explicit_return().bits(), 1024U),
    (NodeFlags::global_augmentation().bits(), 2048U),
    (NodeFlags::has_async_functions().bits(), 4096U),
    (NodeFlags::disallow_in_context().bits(), 8192U),
    (NodeFlags::yield_context().bits(), 16384U),
    (NodeFlags::decorator_context().bits(), 32768U),
    (NodeFlags::await_context().bits(), 65536U),
    (NodeFlags::disallow_conditional_types_context().bits(), 131072U),
    (NodeFlags::this_node_has_error().bits(), 262144U),
    (NodeFlags::javascript_file().bits(), 524288U),
    (NodeFlags::this_node_or_any_sub_nodes_has_error().bits(), 1048576U),
    (NodeFlags::has_aggregated_child_data().bits(), 2097152U),
    (NodeFlags::possibly_contains_dynamic_import().bits(), 4194304U),
    (NodeFlags::possibly_contains_import_meta().bits(), 8388608U),
    (NodeFlags::jsdoc().bits(), 16777216U),
    (NodeFlags::ambient().bits(), 33554432U),
    (NodeFlags::in_with_statement().bits(), 67108864U),
    (NodeFlags::json_file().bits(), 134217728U),
    (NodeFlags::type_cached().bits(), 268435456U),
    (NodeFlags::deprecated().bits(), 536870912U),
    (NodeFlags::unreachable_flag().bits(), 1073741824U),
    (NodeFlags::block_scoped().bits(), 7U),
    (NodeFlags::constant().bits(), 6U),
    (NodeFlags::reachability_check_flags().bits(), 1536U),
    (NodeFlags::reachability_and_emit_flags().bits(), 5632U),
    (NodeFlags::context_flags().bits(), 101441536U),
    (NodeFlags::type_excludes_flags().bits(), 81920U),
    (NodeFlags::permanently_set_incremental_flags().bits(), 12582912U),
    (NodeFlags::identifier_has_extended_unicode_escape().bits(), 256U),
    (NodeFlags::identifier_is_in_jsdoc_namespace().bits(), 4096U),
  ])
  assert_true(NodeFlags::block_scoped().contains(NodeFlags::let_flag()))
  assert_eq(NodeFlags::let_flag().union(NodeFlags::const_flag()).bits(), 3U)
}

///|
test "all TransformFlags values match TypeScript 6.0.3" {
  _assert_flag_values([
    (TransformFlags::none().bits(), 0U),
    (TransformFlags::contains_typescript().bits(), 1U),
    (TransformFlags::contains_jsx().bits(), 2U),
    (TransformFlags::contains_es_next().bits(), 4U),
    (TransformFlags::contains_es2022().bits(), 8U),
    (TransformFlags::contains_es2021().bits(), 16U),
    (TransformFlags::contains_es2020().bits(), 32U),
    (TransformFlags::contains_es2019().bits(), 64U),
    (TransformFlags::contains_es2018().bits(), 128U),
    (TransformFlags::contains_es2017().bits(), 256U),
    (TransformFlags::contains_es2016().bits(), 512U),
    (TransformFlags::contains_es2015().bits(), 1024U),
    (TransformFlags::contains_generator().bits(), 2048U),
    (TransformFlags::contains_destructuring_assignment().bits(), 4096U),
    (TransformFlags::contains_typescript_class_syntax().bits(), 8192U),
    (TransformFlags::contains_lexical_this().bits(), 16384U),
    (TransformFlags::contains_rest_or_spread().bits(), 32768U),
    (TransformFlags::contains_object_rest_or_spread().bits(), 65536U),
    (TransformFlags::contains_computed_property_name().bits(), 131072U),
    (TransformFlags::contains_block_scoped_binding().bits(), 262144U),
    (TransformFlags::contains_binding_pattern().bits(), 524288U),
    (TransformFlags::contains_yield().bits(), 1048576U),
    (TransformFlags::contains_await().bits(), 2097152U),
    (
      TransformFlags::contains_hoisted_declaration_or_completion().bits(),
      4194304U,
    ),
    (TransformFlags::contains_dynamic_import().bits(), 8388608U),
    (TransformFlags::contains_class_fields().bits(), 16777216U),
    (TransformFlags::contains_decorators().bits(), 33554432U),
    (TransformFlags::contains_possible_top_level_await().bits(), 67108864U),
    (TransformFlags::contains_lexical_super().bits(), 134217728U),
    (
      TransformFlags::contains_update_expression_for_identifier().bits(),
      268435456U,
    ),
    (
      TransformFlags::contains_private_identifier_in_expression().bits(),
      536870912U,
    ),
    (TransformFlags::has_computed_flags().bits(), 2147483648U),
    (TransformFlags::assert_typescript().bits(), 1U),
    (TransformFlags::assert_jsx().bits(), 2U),
    (TransformFlags::assert_es_next().bits(), 4U),
    (TransformFlags::assert_es2022().bits(), 8U),
    (TransformFlags::assert_es2021().bits(), 16U),
    (TransformFlags::assert_es2020().bits(), 32U),
    (TransformFlags::assert_es2019().bits(), 64U),
    (TransformFlags::assert_es2018().bits(), 128U),
    (TransformFlags::assert_es2017().bits(), 256U),
    (TransformFlags::assert_es2016().bits(), 512U),
    (TransformFlags::assert_es2015().bits(), 1024U),
    (TransformFlags::assert_generator().bits(), 2048U),
    (TransformFlags::assert_destructuring_assignment().bits(), 4096U),
    (TransformFlags::outer_expression_excludes().bits(), 2147483648U),
    (TransformFlags::property_access_excludes().bits(), 2147483648U),
    (TransformFlags::node_excludes().bits(), 2147483648U),
    (TransformFlags::arrow_function_excludes().bits(), 2222792704U),
    (TransformFlags::function_excludes().bits(), 2357026816U),
    (TransformFlags::constructor_excludes().bits(), 2357018624U),
    (TransformFlags::method_or_accessor_excludes().bits(), 2289909760U),
    (TransformFlags::property_excludes().bits(), 2281717760U),
    (TransformFlags::class_excludes().bits(), 2147622912U),
    (TransformFlags::module_excludes().bits(), 2353291264U),
    (TransformFlags::type_excludes().bits(), 4294967294U),
    (TransformFlags::object_literal_excludes().bits(), 2147688448U),
    (
      TransformFlags::array_literal_or_call_or_new_excludes().bits(),
      2147516416U,
    ),
    (TransformFlags::variable_declaration_list_excludes().bits(), 2148073472U),
    (TransformFlags::parameter_excludes().bits(), 2147483648U),
    (TransformFlags::catch_clause_excludes().bits(), 2147549184U),
    (TransformFlags::binding_pattern_excludes().bits(), 2147516416U),
    (TransformFlags::contains_lexical_this_or_super().bits(), 134234112U),
    (TransformFlags::property_name_propagating_flags().bits(), 134234112U),
  ])
}

///|
test "all TokenFlags values match TypeScript 6.0.3" {
  _assert_flag_values([
    (TokenFlags::none().bits(), 0U),
    (TokenFlags::preceding_line_break().bits(), 1U),
    (TokenFlags::preceding_jsdoc_comment().bits(), 2U),
    (TokenFlags::unterminated().bits(), 4U),
    (TokenFlags::extended_unicode_escape().bits(), 8U),
    (TokenFlags::scientific().bits(), 16U),
    (TokenFlags::octal().bits(), 32U),
    (TokenFlags::hex_specifier().bits(), 64U),
    (TokenFlags::binary_specifier().bits(), 128U),
    (TokenFlags::octal_specifier().bits(), 256U),
    (TokenFlags::contains_separator().bits(), 512U),
    (TokenFlags::unicode_escape().bits(), 1024U),
    (TokenFlags::contains_invalid_escape().bits(), 2048U),
    (TokenFlags::hex_escape().bits(), 4096U),
    (TokenFlags::contains_leading_zero().bits(), 8192U),
    (TokenFlags::contains_invalid_separator().bits(), 16384U),
    (TokenFlags::preceding_jsdoc_leading_asterisks().bits(), 32768U),
    (TokenFlags::binary_or_octal_specifier().bits(), 384U),
    (TokenFlags::with_specifier().bits(), 448U),
    (TokenFlags::string_literal_flags().bits(), 7176U),
    (TokenFlags::numeric_literal_flags().bits(), 25584U),
    (TokenFlags::template_literal_like_flags().bits(), 7176U),
    (TokenFlags::is_invalid().bits(), 26656U),
  ])
  assert_true(
    TokenFlags::numeric_literal_flags().contains(TokenFlags::scientific()),
  )
}

///|
test "all ModifierFlags values match TypeScript 6.0.3" {
  _assert_flag_values([
    (ModifierFlags::none().bits(), 0U),
    (ModifierFlags::public_flag().bits(), 1U),
    (ModifierFlags::private_flag().bits(), 2U),
    (ModifierFlags::protected_flag().bits(), 4U),
    (ModifierFlags::readonly_flag().bits(), 8U),
    (ModifierFlags::override_flag().bits(), 16U),
    (ModifierFlags::export_flag().bits(), 32U),
    (ModifierFlags::abstract_flag().bits(), 64U),
    (ModifierFlags::ambient().bits(), 128U),
    (ModifierFlags::static_flag().bits(), 256U),
    (ModifierFlags::accessor().bits(), 512U),
    (ModifierFlags::async_flag().bits(), 1024U),
    (ModifierFlags::default_flag().bits(), 2048U),
    (ModifierFlags::const_flag().bits(), 4096U),
    (ModifierFlags::in_flag().bits(), 8192U),
    (ModifierFlags::out_flag().bits(), 16384U),
    (ModifierFlags::decorator().bits(), 32768U),
    (ModifierFlags::deprecated().bits(), 65536U),
    (ModifierFlags::jsdoc_public().bits(), 8388608U),
    (ModifierFlags::jsdoc_private().bits(), 16777216U),
    (ModifierFlags::jsdoc_protected().bits(), 33554432U),
    (ModifierFlags::jsdoc_readonly().bits(), 67108864U),
    (ModifierFlags::jsdoc_override().bits(), 134217728U),
    (ModifierFlags::syntactic_or_jsdoc_modifiers().bits(), 31U),
    (ModifierFlags::syntactic_only_modifiers().bits(), 65504U),
    (ModifierFlags::syntactic_modifiers().bits(), 65535U),
    (ModifierFlags::jsdoc_cache_only_modifiers().bits(), 260046848U),
    (ModifierFlags::jsdoc_only_modifiers().bits(), 65536U),
    (ModifierFlags::non_cache_only_modifiers().bits(), 131071U),
    (ModifierFlags::has_computed_jsdoc_modifiers().bits(), 268435456U),
    (ModifierFlags::has_computed_flags().bits(), 536870912U),
    (ModifierFlags::accessibility_modifier().bits(), 7U),
    (ModifierFlags::parameter_property_modifier().bits(), 31U),
    (ModifierFlags::non_public_accessibility_modifier().bits(), 6U),
    (ModifierFlags::typescript_modifier().bits(), 28895U),
    (ModifierFlags::export_default().bits(), 2080U),
    (ModifierFlags::all().bits(), 131071U),
    (ModifierFlags::modifier().bits(), 98303U),
  ])
}

///|
test "pragma and regexp flags match TypeScript 6.0.3" {
  _assert_flag_values([
    (PragmaKindFlags::none().bits(), 0U),
    (PragmaKindFlags::triple_slash_xml().bits(), 1U),
    (PragmaKindFlags::single_line().bits(), 2U),
    (PragmaKindFlags::multi_line().bits(), 4U),
    (PragmaKindFlags::all().bits(), 7U),
    (PragmaKindFlags::default_flags().bits(), 7U),
    (RegularExpressionFlags::none().bits(), 0U),
    (RegularExpressionFlags::has_indices().bits(), 1U),
    (RegularExpressionFlags::global().bits(), 2U),
    (RegularExpressionFlags::ignore_case().bits(), 4U),
    (RegularExpressionFlags::multiline().bits(), 8U),
    (RegularExpressionFlags::dot_all().bits(), 16U),
    (RegularExpressionFlags::unicode().bits(), 32U),
    (RegularExpressionFlags::unicode_sets().bits(), 64U),
    (RegularExpressionFlags::sticky().bits(), 128U),
    (RegularExpressionFlags::any_unicode_mode().bits(), 96U),
    (RegularExpressionFlags::modifiers().bits(), 28U),
  ])
}
